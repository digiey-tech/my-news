# Copy to .env for local development. Never commit real values.

# Postgres connection string (production). Leave empty to use a local SQLite file.
DATABASE_URL=
# Local SQLite file used when DATABASE_URL is empty.
SQLITE_PATH=./data/mynews.db

PORT=8080

# Protects POST /api/admin/collect. Use a long random string.
ADMIN_TOKEN=replace-with-a-long-random-string

# --- AI provider (server only - never put keys in the Flutter app) ---
# gemini (default, free tier) | openai_compatible (Groq, OpenRouter, ...) | anthropic
AI_PROVIDER=gemini
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=replace-with-your-gemini-key

# Optional overrides of prompts/model_config.json
# AI_MODEL=gemini-3.8-flash
# AI_EFFORT=medium
# Milliseconds to wait between model calls (free tiers limit requests per minute).
# AI_MIN_INTERVAL_MS=7000

# For AI_PROVIDER=openai_compatible, e.g. Groq:
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=<model name from the provider>
# AI_API_KEY=replace-me
# For AI_PROVIDER=anthropic:
# ANTHROPIC_API_KEY=replace-me

# Maximum AI summary generations per hourly run (keeps you inside free daily quotas).
MAX_AI_CALLS_PER_RUN=10
# Set to 2 to generate AI analysis only for stories with 2+ publishers (saves quota).
AI_MIN_PUBLISHERS=1

# Run the hourly schedule inside the web process. Only useful when the host keeps
# the process awake. The GitHub Actions workflow is the default scheduler.
ENABLE_INTERNAL_SCHEDULER=false

# Contact string sent in the User-Agent to Wikipedia and feed hosts.
CONTACT=your-email@example.edu
